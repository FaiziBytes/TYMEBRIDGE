# Copy this file to `.env` and fill in the blanks.
# Secrets are left empty on purpose; non-secret config has sensible defaults.
# The server validates these at boot (server/config/env.ts) and refuses to
# start with a clear message if anything required is missing or malformed.

# --- Core ---
# DATABASE_URL is required. PostgreSQL connection string.
DATABASE_URL=
PORT=5000
FRONTEND_URL=http://localhost:5000

# --- Client (Vite) — must be prefixed with VITE_ ---
VITE_API_BASE_URL=http://localhost:5000/api

# --- Auth (JWT) ---
# JWT_SECRET is required and must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left blank in development the server mints a random secret per run (tokens
# reset on restart). In production a missing/short secret aborts startup.
JWT_SECRET=
# Optional. Falls back to JWT_SECRET when blank. Same 32-character minimum.
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Google OAuth (optional — leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/auth/google/callback

# --- OTP ---
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_MS=60000
OTP_EXPIRY_MS=300000
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_MS=900000

# --- Email (SMTP via Brevo) ---
# Brevo dashboard → SMTP & API → SMTP. Use the relay host below.
#   SMTP_USER     = the login shown there (e.g. 9a1b2c001@smtp-brevo.com)
#   SMTP_PASSWORD = your Brevo SMTP key (NOT your account login password)
#   SMTP_FROM     = a sender you've verified in Brevo (Senders & domains)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- WhatsApp (Meta Cloud API — for WhatsApp number OTP) ---
# Meta for Developers → your WhatsApp app → API Setup.
#   WHATSAPP_PHONE_NUMBER_ID = the "Phone number ID" shown there
#   WHATSAPP_ACCESS_TOKEN    = a (permanent/system-user) access token
#   WHATSAPP_OTP_TEMPLATE    = name of an APPROVED "Authentication" template
# Leave any blank to keep delivery disabled — the OTP is then logged to the
# server console (like the [dev mail] fallback) so you can still test the flow.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# Meta's default Authentication template includes a copy-code button; set to
# false only if you created a template without one.
WHATSAPP_OTP_COPY_BUTTON=true

# --- Zoom (auto-scheduled meetings for video/audio bookings) ---
# Create a Server-to-Server OAuth app under ONE central Zoom account
# (Marketplace → Develop → Build App → Server-to-Server OAuth). Experts never
# connect their own account — every meeting is hosted by this account.
# Required scope: meeting:write:admin (and meeting:read:admin to read back).
# Copy the three values from the app's "App Credentials" tab.
# Leave them blank to disable real scheduling: a simulated meeting link is then
# generated and logged ([dev zoom]) so the booking → meeting-link flow stays
# testable, mirroring the [dev mail]/[dev whatsapp] fallbacks.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom user that hosts the meetings: "me" = the app's own account (single
# shared host). Set to a user id/email to host as a specific (licensed) user.
ZOOM_HOST_USER_ID=me
# Booking delivery modes that get a Zoom meeting (subset of
# video,audio,chat,in_person). chat & in_person don't need a link.
ZOOM_MEETING_TYPES=video,audio
# Cross-origin isolation on /call only. Required for Zoom's gallery view (more
# than one video at a time). Set to false to roll back without a redeploy.
ZOOM_CALL_ISOLATION=true

REDIS_URL=

FIELD_ENCRYPTION_KEY=

RETENTION_SWEEP_ENABLED=true
RETENTION_OTP_HOURS=24
RETENTION_REFRESH_TOKEN_DAYS=30
RETENTION_OUTBOX_DAYS=7
RETENTION_ZOOM_EVENT_DAYS=90
RETENTION_NOTIFICATION_DAYS=180

# --- AWS S3 (image & document uploads: avatars, consultation covers,
# verification documents) ---
# Leave AWS_S3_BUCKET blank to disable S3 — uploads then fall back to local
# disk (./uploads, served at /uploads) so the flow stays testable in dev. On
# serverless (Vercel/Lambda) S3 must be configured, otherwise upload endpoints
# return 501 (only /tmp is writable there and /uploads is never mounted).
AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: public base URL for objects (CloudFront / custom domain / custom S3
# endpoint). Defaults to https://<bucket>.s3.<region>.amazonaws.com when unset.
AWS_S3_PUBLIC_URL=

# --- Bull Board (BullMQ queue dashboard at /api/admin/queues) ---
# Only mounted when REDIS_URL is set (BullMQ enabled). Optional HTTP Basic Auth:
# set both to require a login; leave blank to keep it open in development
# (it is disabled entirely in production when unset).
BULLBOARD_USER=
BULLBOARD_PASSWORD=


MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
# Optional shared secret; when set it must be echoed in the webhook payload.
MYFATOORAH_WEBHOOK_SECRET=
# Currency MyFatoorah invoices are raised in (KWD, SAR, AED, …).
PAYMENT_CURRENCY=SAR
# TEST ONLY — recurring billing accelerator. When > 0, subscription periods
# last this many MINUTES instead of months and a server-side timer auto-renews
# due subscriptions every minute, so you can watch renewals happen live (works
# with the simulated dev gateway, no Redis needed). Set to 60 for hourly
# renewals, or e.g. 2 for a faster loop. MUST be 0 in production.
BILLING_TEST_INTERVAL_MINUTES=0
# Server origin used to build MyFatoorah CallBackUrl/ErrorUrl. Must be publicly
# reachable in production so the gateway (and its webhook) can reach back.
PUBLIC_BASE_URL=http://localhost:5000
# MyFatoorah v2 Embedded Payment card-view SDK (client/Vite). Must match
# MYFATOORAH_BASE_URL's environment. Test/demo: the default below.
# Live: https://portal.myfatoorah.com (KW/BH/JO/OM), https://sa.myfatoorah.com
# (SA), https://ae.myfatoorah.com (AE), https://qa.myfatoorah.com (QA),
# https://eg.myfatoorah.com (EG) — all with the /cardview/v2/session.js path.
VITE_MYFATOORAH_EMBED_SCRIPT=https://demo.myfatoorah.com/cardview/v2/session.js
